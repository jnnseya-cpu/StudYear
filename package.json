{
  "name": "studyear",
  "private": true,
  "version": "0.1.0",
  "description": "StudYear — The AI Academic Operating System (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/functions"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:functions": "npm run build --workspace backend/functions",
    "deploy:web": "vercel deploy apps/web --prod",
    "deploy:backend": "firebase deploy --config backend/firebase.json",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=20" }
}
